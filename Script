fprintf('Phase 2 r1 = %.3f (Grenze ±%.3f)\n', r1_days2, 1.96/sqrt(n2));

[~, ~, pDays1c, sigDays1c, neffDays1] = mannKendallCorrected(phaseDays1, r1_days1);
fprintf('Phase 1 korrigiert: p=%.4f, sig=%d, n_eff=%.1f (statt n=%d)\n', pDays1c, sigDays1c, neffDays1, numel(phaseDays1));

