%% 18. Driver registry (adjust here if a driver is missing - e.g. comment out Chlorophyll for other stations)

coefTable = mdl_Driver.Coefficients;
getCoef = @(nm) coefTable.Estimate(strcmp(coefTable.Row, nm));

driverRegistry = struct('name',{}, 'tbl',{}, 'lag',{}, 'hasModel',{}, 'coef',{});

driverRegistry(end+1) = struct('name','Temperature',   'tbl',Tempraw, 'lag',lag_Temp, 'hasModel',true,  'coef',getCoef('Temperatur'));
driverRegistry(end+1) = struct('name','Conductivity',  'tbl',Condraw, 'lag',lag_Cond, 'hasModel',true,  'coef',getCoef('Conductivity'));
driverRegistry(end+1) = struct('name','pH',            'tbl',pHraw,   'lag',lag_pH,   'hasModel',true,  'coef',getCoef('pH'));
driverRegistry(end+1) = struct('name','Turbidity',     'tbl',Turraw,  'lag',lag_Tur,  'hasModel',true,  'coef',getCoef('Truebung'));

coefTable_Chl = mdl_Driver_Chl.Coefficients;
getCoef_Chl = @(nm) coefTable_Chl.Estimate(strcmp(coefTable_Chl.Row, nm));

driverRegistry(end+1) = struct('name','Chlorophyll',   'tbl',Chlraw,  'lag',0,        'hasModel',true, 'coef',getCoef_Chl('Chlorophyll'));

nDrivers = numel(driverRegistry);

%% 19. Event Catalog: characterizing each individual event (incl. driver profile)

nEventsTotal = length(ev_start);

n_hypoxic_days_event = NaN(nEventsTotal,1);
n_sevHypoxic_days_event  = NaN(nEventsTotal,1);
n_bridge_days_event  = NaN(nEventsTotal,1);
min_DO_event = NaN(nEventsTotal,1);
max_DO_event = NaN(nEventsTotal,1);

driverAnomCols = NaN(nEventsTotal, nDrivers);
driverContribCols = NaN(nEventsTotal, nDrivers);

for i = 1:nEventsTotal
    idx_event = ev_start(i):ev_end(i);
    n_hypoxic_days_event(i) = sum(is_hypoxic(idx_event));
    n_sevHypoxic_days_event(i)  = sum(is_sevHypoxic(idx_event));
    n_bridge_days_event(i)  = sum(category(idx_event) == 4);
    min_DO_event(i) = min(DOraw.value(idx_event));
    max_DO_event(i) = max(DOraw.value(idx_event));

    evStartDate = DOraw.time(ev_start(i));
    evEndDate   = DOraw.time(ev_end(i));

    for d = 1:nDrivers
        drv = driverRegistry(d);
        winStart = evStartDate - days(drv.lag);
        winEnd   = evEndDate   - days(drv.lag);

        idxWin = drv.tbl.time >= winStart & drv.tbl.time <= winEnd;

        if any(idxWin)
            driverAnomCols(i,d) = mean(drv.tbl.anomaly(idxWin), 'omitnan');
        end

        if drv.hasModel && ~isnan(driverAnomCols(i,d))
            driverContribCols(i,d) = drv.coef * driverAnomCols(i,d);
        end
    end
end

range_DO_event = max_DO_event - min_DO_event;

event_start_date = DOraw.time(ev_start);
event_end_date   = DOraw.time(ev_end);

EventCatalogFull = table(event_start_date, event_end_date, ev_duration, ...
    n_hypoxic_days_event, n_sevHypoxic_days_event, n_bridge_days_event, ...
    min_DO_event, max_DO_event, range_DO_event, ...
    'VariableNames', {'Start Date','End Date','Total Days', ...
    'Days below 4 mg/L','Days below 2 mg/L','Bridge Days', ...
    'Min DO (mg/L)','Max DO (mg/L)','DO Range (mg/L)'});

for d = 1:nDrivers
    drv = driverRegistry(d);
    EventCatalogFull.(drv.name + " Anomaly") = driverAnomCols(:,d);
    if drv.hasModel
