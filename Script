%% 7.3 Rooling Window for Climatology Check 

years_all = year(DOraw.time);
firstYear = min(years_all);
lastYear  = max(years_all);
rollResults = struct();

for w = 1:numel(windowSizes)
    windowYears = windowSizes(w);
    startYears = firstYear : (lastYear - windowYears + 1);
    amplitude = nan(numel(startYears),1);
    for i = 1:numel(startYears)
        winIdx = years_all >= startYears(i) & years_all < startYears(i) + windowYears;
        doy_win = day(DOraw.time(winIdx), 'dayofyear');
        val_win = DOraw.value(winIdx);
        [G, ~] = findgroups(doy_win);
        clim_win = splitapply(@(x) mean(x,'omitnan'), val_win, G);
        amplitude(i) = max(clim_win) - min(clim_win);
    end
    f = sprintf('w%d', windowYears);
    rollResults.(f).midYears  = startYears + windowYears/2;
    rollResults.(f).amplitude = amplitude;
end

figure('Name','Rolling Climatology Range: Window Comparison'); hold on
