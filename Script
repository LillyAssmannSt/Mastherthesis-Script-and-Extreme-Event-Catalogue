%% Driver-Data: Water Temperature 

Tempraw = readtable("Bunthaus Water Temp.csv","NumHeaderLines",5,"ReadVariableNames",true,"DecimalSeparator",",","Delimiter",";");
Tempraw = renamevars(Tempraw,["Zeitstempel","Wert"],["time","value"]);
if width(Tempraw) > 2
    Tempraw = Tempraw(:,{'time','value'});  
end

Tempraw = table2timetable(Tempraw, 'RowTimes','time');
Tempraw = retime(Tempraw, 'regular', 'fillwithmissing', 'TimeStep', days(1));
Tempraw = timetable2table(Tempraw, 'ConvertRowTimes', true);

Tempraw.flag = repmat("measurement", height(Tempraw), 1);
Tempraw.wasMissingOriginal = isnan(Tempraw.value);
Tempraw.flag(Tempraw.wasMissingOriginal) = "missing_value";
Tempraw.wasOutlier = false(height(Tempraw),1);

fprintf('Wassertemperatur - Zeitraum: %s bis %s, Zeilen: %d\n', ...
    datestr(min(Tempraw.time)), datestr(max(Tempraw.time)), height(Tempraw));

dailyJump = diff(Tempraw.value);

figure('Name','Verteilung der Tag-zu-Tag-Sprünge - Wassertemperatur');
histogram(dailyJump, 'BinWidth', 0.5);
xlabel('Temperature Change [°C] per Day'); ylabel('Frequency'); grid off
exportgraphics(gcf, 'Verteilung der Tag-zu-Tag-Sprünge - Wassertemperatur.png', 'Resolution', 300);

sdJump = std(dailyJump, 'omitnan');
threshold_provisional = 5 * sdJump;   % ADJUST ACCORDINGLY
fprintf('Vorläufiger Rate-of-Change-Schwellenwert Temperatur (5xSD): %.2f °C/Tag\n', threshold_provisional);

jumpThreshold_Temp = threshold_provisional;  

diffPrev = [NaN; diff(Tempraw.value)];
diffNext = [diff(Tempraw.value); NaN];
isSpike = abs(diffPrev) > jumpThreshold_Temp & abs(diffNext) > jumpThreshold_Temp;

fprintf('Als isolierter Spike markiert (Temperatur): %d Punkte\n', sum(isSpike));

Tempraw.value(isSpike) = NaN;
Tempraw.wasOutlier(isSpike) = true;
Tempraw.flag(isSpike) = "outlier_rateofchange";

% Interpolation

nanBefore = isnan(Tempraw.value);
Tempraw.value = fillmissing(Tempraw.value, 'linear', 'MaxGap',3);
Tempraw.flag(nanBefore & ~isnan(Tempraw.value)) = "linear_interpoliert";

nanBefore = isnan(Tempraw.value);
Tempraw.value = fillmissing(Tempraw.value, 'spline', 'MaxGap', 6);
Tempraw.flag(nanBefore & ~isnan(Tempraw.value)) = "spline_interpoliert";

doy = day(Tempraw.time, 'dayofyear');
validIdx = ~isnan(Tempraw.value);
[G, doyList] = findgroups(doy(validIdx));
climMean = splitapply(@mean, Tempraw.value(validIdx), G);
climLookup = nan(366,1);
climLookup(doyList) = climMean;

missingIdx = isnan(Tempraw.value);
Tempraw.value(missingIdx) = climLookup(doy(missingIdx));
Tempraw.flag(missingIdx) = "klimatologisch_gefuellt";

assert(sum(isnan(Tempraw.value)) == 0, "Es sind noch NaN in Tempraw.value vorhanden.");
summary(categorical(Tempraw.flag))

%% Driver-Data: Water Temperature - Seasonality (STL)

TT_Temp = table2timetable(Tempraw(:,["time","value"]));
[longtermTrend_Temp, seasonalTrend_Temp, residual_Temp] = trenddecomp(TT_Temp.value, 'stl', 365);

figure("Name", "STL Decomposition - Wassertemperatur");
subplot(4,1,1), plot(TT_Temp.time, TT_Temp.value), title('Original H20-Temp Data'), grid off;
subplot(4,1,2), plot(TT_Temp.time, longtermTrend_Temp), title('Trend Component'), grid off;
subplot(4,1,3), plot(TT_Temp.time, seasonalTrend_Temp), title('Seasonal Component'), grid off;
subplot(4,1,4), plot(TT_Temp.time, residual_Temp), title('Residual Component'), grid off;
exportgraphics(gcf, 'STL Decomposition - Wassertemperatur.png', 'Resolution', 300);

Fs_Temp = max(0, 1 - var(residual_Temp,'omitnan') / var(seasonalTrend_Temp + residual_Temp, 'omitnan'));
fprintf('Saisonalitätsstärke Wassertemperatur (Fs): %.3f\n', Fs_Temp);

