doAnom_Temp  = DOraw.anomaly(idxDO_Temp);
drvAnom_Temp = Tempraw.anomaly(idxTemp_Temp);

lags_Temp = -maxLag:maxLag;
corrVals_Temp = NaN(size(lags_Temp));

for i = 1:numel(lags_Temp)
    L = lags_Temp(i);
    if L >= 0
        doSeg  = doAnom_Temp(L+1:end);
        drvSeg = drvAnom_Temp(1:end-L);
    else
        doSeg  = doAnom_Temp(1:end+L);
        drvSeg = drvAnom_Temp(-L+1:end);
    end
    corrVals_Temp(i) = corr(doSeg, drvSeg, 'rows','complete');
end

