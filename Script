fprintf('Phase 2 (ab %d):  tau=%.3f, p=%.4f, sig=%d, Sen-Slope=%.4f Tage/Jahr\n', breakYearDays, tauDays2,pDays2,sigDays2,slopeDays2);

n1 = numel(phaseDays1); xbar1 = mean(phaseDays1);
r1_days1 = sum((phaseDays1(1:end-1)-xbar1).*(phaseDays1(2:end)-xbar1)) / sum((phaseDays1-xbar1).^2);
fprintf('Phase 1 r1 = %.3f (Grenze ±%.3f)\n', r1_days1, 1.96/sqrt(n1));

n2 = numel(phaseDays2); xbar2 = mean(phaseDays2);
