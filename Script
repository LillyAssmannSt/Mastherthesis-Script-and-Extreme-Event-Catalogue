    n_bridge_per_year(k)  = sum(category(idx_yr) == 4);
end

assert(isequal(n_p10_per_year + n_hypoxic_per_year + n_sevHypoxic_per_year + n_bridge_per_year, ...
    n_days_below_per_year), "Kategorien summieren sich nicht zu den Eventtagen pro Jahr.");

