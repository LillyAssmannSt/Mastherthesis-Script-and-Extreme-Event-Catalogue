%% Functions 


% Mann-Kendall
function [S, tau, p, H] = mannKendall(x, alpha)
if nargin < 2, alpha = 0.05; end
    x = x(:); n = length(x);
    S = 0;
for k = 1:n-1
        S = S + sum(sign(x(k+1:n) - x(k)));
end
    [~,~,ic] = unique(x);
    g = histcounts(ic, 1:max(ic)+1);
    g = g(g > 1);
    varS = n*(n-1)*(2*n+5)/18 - sum(g.*(g-1).*(2*g+5))/18;
if S > 0
        Z = (S-1)/sqrt(varS);
elseif S < 0
        Z = (S+1)/sqrt(varS);
else
        Z = 0;
end
    p = 1 - erf(abs(Z)/sqrt(2));   % zweiseitiger p-Wert
    H = p < alpha;                  % 1 = signifikanter Trend
    tau = S / (n*(n-1)/2);
end


% Sen's Slope (robuste Trendsteigung, mg/L pro Jahr)
function slope = sensSlope(x)
    x = x(:).';   % erzwingt Zeilenvektor
    n = length(x);
    slopes = [];
for k = 1:n-1
        slopes = [slopes, (x(k+1:n) - x(k)) ./ (1:(n-k))];
end
    slope = median(slopes);
end


% Find Change Point
function [breakIdx, bestSSE] = findChangepointLinear(x, minSegLen)
    if nargin < 2
        minSegLen = 3;
    end
    x = x(:);
    n = length(x);
    t = (1:n)';

    bestSSE = Inf;
    breakIdx = NaN;

    for k = minSegLen : (n - minSegLen)
        seg1_t = t(1:k);       seg1_x = x(1:k);
        seg2_t = t(k+1:end);   seg2_x = x(k+1:end);

        p1 = polyfit(seg1_t, seg1_x, 1);
        p2 = polyfit(seg2_t, seg2_x, 1);

        resid1 = seg1_x - polyval(p1, seg1_t);
        resid2 = seg2_x - polyval(p2, seg2_t);

        sse = sum(resid1.^2) + sum(resid2.^2);

        if sse < bestSSE
            bestSSE = sse;
            breakIdx = k + 1;
        end
    end
end


% Mann-Kendall Corrected
function [S, tau, p, H, neff] = mannKendallCorrected(x, r1, alpha)
    if nargin < 3, alpha = 0.05; end
    x = x(:); n = length(x);
    S = 0;
    for k = 1:n-1
        S = S + sum(sign(x(k+1:n) - x(k)));
    end
    [~,~,ic] = unique(x);
    g = histcounts(ic, 1:max(ic)+1);
    g = g(g > 1);

    % Klassische (naive) Varianz unter Unabhängigkeitsannahme
    varS_naive = n*(n-1)*(2*n+5)/18 - sum(g.*(g-1).*(2*g+5))/18;

    % Effektive Stichprobengröße (AR(1)-Näherung)
    neff = n * (1 - r1) / (1 + r1);
    neff = max(neff, 3);   % Untergrenze, um Entartung zu vermeiden

    % Korrigierte, aufgeblähte Varianz
    varS = varS_naive * (n / neff);

    if S > 0
        Z = (S-1)/sqrt(varS);
    elseif S < 0
        Z = (S+1)/sqrt(varS);
    else
        Z = 0;
    end
    p = 1 - erf(abs(Z)/sqrt(2));
    H = p < alpha;
    tau = S / (n*(n-1)/2);
end


% Find Change Point Linear 2
function [breakIdx1, breakIdx2, bestSSE] = findChangepointLinear2(x, minSegLen)
    % Erweiterung von findChangepointLinear auf zwei Bruchpunkte (3 Segmente)
    if nargin < 2, minSegLen = 3; end
    x = x(:); n = length(x); t = (1:n)';
    bestSSE = Inf; breakIdx1 = NaN; breakIdx2 = NaN;
    for k1 = minSegLen : (n - 2*minSegLen)
        for k2 = (k1+minSegLen) : (n - minSegLen)
            seg1_t = t(1:k1);         seg1_x = x(1:k1);
            seg2_t = t(k1+1:k2);      seg2_x = x(k1+1:k2);
            seg3_t = t(k2+1:end);     seg3_x = x(k2+1:end);
            p1 = polyfit(seg1_t, seg1_x, 1);
            p2 = polyfit(seg2_t, seg2_x, 1);
            p3 = polyfit(seg3_t, seg3_x, 1);
            resid1 = seg1_x - polyval(p1, seg1_t);
            resid2 = seg2_x - polyval(p2, seg2_t);
            resid3 = seg3_x - polyval(p3, seg3_t);
            sse = sum(resid1.^2) + sum(resid2.^2) + sum(resid3.^2);
            if sse < bestSSE
                bestSSE = sse;
                breakIdx1 = k1 + 1;
                breakIdx2 = k2 + 1;
            end
        end
    end
end

% Hobday Analyse 
function [n_events, idx_start, idx_end] = count_events_hobday(is_below, min_duration, max_gap)
% Eventdefinition nach Hobday et al. (2016)
% min_duration: Mindestdauer eines Events in Messtagen (z.B. 5)
% max_gap: maximale Lücke zwischen Events um sie zu mergen (z.B. 2)

padded = [false; is_below(:); false];
starts = find(padded(1:end-1) == false & padded(2:end) == true);
ends   = find(padded(1:end-1) == true  & padded(2:end) == false) - 1;

duration = ends - starts + 1;
valid    = duration >= min_duration;
starts   = starts(valid);
ends     = ends(valid);

if isempty(starts)
    n_events  = 0;
    idx_start = [];
    idx_end   = [];
    return
end

merged_starts = starts(1);
merged_ends   = ends(1);

for i = 2:length(starts)
    gap = starts(i) - merged_ends(end) - 1;
    if gap < max_gap
        merged_ends(end) = ends(i);
    else
        merged_starts(end+1) = starts(i);
        merged_ends(end+1)   = ends(i);
    end
end

duration_merged = merged_ends - merged_starts + 1;
valid_merged    = duration_merged >= min_duration;
merged_starts   = merged_starts(valid_merged);
merged_ends     = merged_ends(valid_merged);

n_events  = length(merged_starts);
idx_start = merged_starts(:);
idx_end   = merged_ends(:);
end
