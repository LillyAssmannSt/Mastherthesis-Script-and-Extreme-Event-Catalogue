%% 13.2 Analysis of Frequency of Extremevents
% Quasi-Poisson-Trend 

x_years = yearList - yearList(1);
mdl_poisson = fitglm(x_years, n_events_per_year, 'Distribution','poisson');
disp(mdl_poisson)

mu_hat = mdl_poisson.Fitted.Response;
pearsonResid = (n_events_per_year - mu_hat) ./ sqrt(mu_hat);
pearsonChi2  = sum(pearsonResid.^2);
dispersionPhi = pearsonChi2 / mdl_poisson.DFE;
fprintf('Overdispersion-Parameter (phi): %.3f\n', dispersionPhi);
if dispersionPhi > 1
    fprintf('-> phi > 1: Überdispersion vorhanden, Quasi-Poisson-Korrektur wird angewendet.\n');
else
    fprintf('-> phi <= 1: keine Überdispersion, Standard-Poisson-Ergebnisse bleiben gültig.\n');
end

beta         = mdl_poisson.Coefficients.Estimate;
se_poisson   = mdl_poisson.Coefficients.SE;
se_quasi     = se_poisson * sqrt(dispersionPhi);
z_quasi = beta ./ se_quasi;
p_quasi = 2 * (1 - normcdf(abs(z_quasi)));
QuasiPoissonResults = table(mdl_poisson.Coefficients.Row, beta, se_quasi, z_quasi, p_quasi,'VariableNames', {'Coefficient','Estimate','SE_quasi','z_quasi','p_quasi'});
disp(QuasiPoissonResults)

slope_events      = beta(2);
rateRatio_events  = exp(slope_events);
pctChange_events  = (rateRatio_events - 1) * 100;
fprintf('Trend Eventfrequenz (Quasi-Poisson): %.2f%% Veränderung pro Jahr (Rate Ratio = %.4f), p = %.4f\n',pctChange_events, rateRatio_events, p_quasi(2));

figure("Name","Eventfrequency per Year - Quasi-Poisson-Trend at " + stationName);
bar(yearList, n_events_per_year, "FaceColor",[1 0.75 0], "DisplayName","Events per Year");
hold on
plot(yearList, mu_hat, "r-", "LineWidth", 2, "DisplayName", sprintf("Quasi-Poisson-Trend: %.2f%%/Year, p=%.3f", pctChange_events, p_quasi(2)));
grid off
xlabel("Year"); ylabel("Number of Events");
title("Eventfrequency per Year - Quasi-Poisson-Trend at " + stationName);
legend("Location","northwest");
exportgraphics(gcf, 'Eventfrequency per Year - Quasi-Poisson-Trend.png', 'Resolution', 300);

%% 13.2.1 Beakpointanalysis: Eventfrequency (Quasi-Poisson je Phase)

[bFreq, sseFreq] = findChangepointLinear(n_events_per_year, 3);
breakYearFreq = yearList(bFreq);
fprintf('Bruchpunkt (Eventfrequenz): %d\n', breakYearFreq);

idxPhase1 = yearList <  breakYearFreq;
idxPhase2 = yearList >= breakYearFreq;
years_p1  = yearList(idxPhase1);
years_p2  = yearList(idxPhase2);
events_p1 = n_events_per_year(idxPhase1);
events_p2 = n_events_per_year(idxPhase2);
fprintf('Phase 1: n=%d Jahre, Phase 2: n=%d Jahre\n', numel(years_p1), numel(years_p2));

if numel(years_p1) < 5 || numel(years_p2) < 5
    warning('Mindestens eine Phase hat weniger als 5 Jahre - Poisson/Quasi-Poisson-Schätzung ist bei so wenig Datenpunkten instabil, Ergebnisse nur als Tendenz interpretieren.');
end

x_p1 = years_p1 - years_p1(1);
x_p2 = years_p2 - years_p2(1);

mdl_poisson_p1 = fitglm(x_p1, events_p1, 'Distribution','poisson');
mu_hat_p1 = mdl_poisson_p1.Fitted.Response;
pearsonResid_p1 = (events_p1 - mu_hat_p1) ./ sqrt(mu_hat_p1);
phi_p1 = sum(pearsonResid_p1.^2) / mdl_poisson_p1.DFE;
beta_p1     = mdl_poisson_p1.Coefficients.Estimate;
se_quasi_p1 = mdl_poisson_p1.Coefficients.SE * sqrt(phi_p1);
p_quasi_p1  = 2 * (1 - normcdf(abs(beta_p1 ./ se_quasi_p1)));
rateRatio_p1 = exp(beta_p1(2));
pctChange_p1 = (rateRatio_p1 - 1) * 100;
fprintf('Phase 1 (vor %d): phi=%.2f, %.2f%% Veränderung/Jahr (Rate Ratio=%.4f), p=%.4f\n', ...
    breakYearFreq, phi_p1, pctChange_p1, rateRatio_p1, p_quasi_p1(2));

mdl_poisson_p2 = fitglm(x_p2, events_p2, 'Distribution','poisson');
mu_hat_p2 = mdl_poisson_p2.Fitted.Response;
pearsonResid_p2 = (events_p2 - mu_hat_p2) ./ sqrt(mu_hat_p2);
phi_p2 = sum(pearsonResid_p2.^2) / mdl_poisson_p2.DFE;
beta_p2     = mdl_poisson_p2.Coefficients.Estimate;
se_quasi_p2 = mdl_poisson_p2.Coefficients.SE * sqrt(phi_p2);
p_quasi_p2  = 2 * (1 - normcdf(abs(beta_p2 ./ se_quasi_p2)));
rateRatio_p2 = exp(beta_p2(2));
pctChange_p2 = (rateRatio_p2 - 1) * 100;
fprintf('Phase 2 (ab %d): phi=%.2f, %.2f%% Veränderung/Jahr (Rate Ratio=%.4f), p=%.4f\n', ...
    breakYearFreq, phi_p2, pctChange_p2, rateRatio_p2, p_quasi_p2(2));

figure("Name","Eventfrequency with Breakpoint-Trend (Quasi-Poisson) at " + stationName);
bar(yearList, n_events_per_year, "FaceColor",[1 0.75 0], "DisplayName","Events per Year");
hold on
plot(years_p1, mu_hat_p1, "b-", "LineWidth", 2,"DisplayName", sprintf("Phase 1: %.2f%%/Year, p=%.3f", pctChange_p1, p_quasi_p1(2)));
plot(years_p2, mu_hat_p2, "r-", "LineWidth", 2, "DisplayName", sprintf("Phase 2: %.2f%%/Year, p=%.3f", pctChange_p2, p_quasi_p2(2)));
xline(breakYearFreq, "--k", "HandleVisibility","off");
grid off
xlabel("Year"); ylabel("Number of Events");
title("Eventfrequency with Breakpoint-Trend (Quasi-Poisson) at " + stationName);
legend("Location","northwest");
