fprintf('Phase 1 r1 = %.3f (Grenze ±%.3f)\n', r1_p1, 1.96/sqrt(n1));

n2 = numel(phaseR2); xbar2 = mean(phaseR2);
r1_p2 = sum((phaseR2(1:end-1)-xbar2).*(phaseR2(2:end)-xbar2)) / sum((phaseR2-xbar2).^2);
fprintf('Phase 2 r1 = %.3f (Grenze ±%.3f)\n', r1_p2, 1.96/sqrt(n2));

[~, ~, pR1c, sigR1c, neffR1] = mannKendallCorrected(phaseR1, r1_p1);
fprintf('Phase 1 korrigiert: p=%.4f, sig=%d, n_eff=%.1f (statt n=%d)\n', pR1c, sigR1c, neffR1, numel(phaseR1));

[~, ~, pR2c, sigR2c, neffR2] = mannKendallCorrected(phaseR2, r1_p2);
fprintf('Phase 2 korrigiert: p=%.4f, sig=%d, n_eff=%.1f (statt n=%d)\n', pR2c, sigR2c, neffR2, numel(phaseR2));

meanPhaseR1 = mean(phaseR1);
meanPhaseR2 = mean(phaseR2);
fprintf('Mittelwert Spannweite Phase 1 (vor %d): %.2f mg/L\n', breakYearR, meanPhaseR1);
fprintf('Mittelwert Spannweite Phase 2 (ab %d):  %.2f mg/L\n', breakYearR, meanPhaseR2);


%% From here on, the extreme event analysis begins

% 1. Calculate daily climatologies over the entire period (because even though
% the seasonal amplitude has changed, it has not shown a
% significant trend so far), using a window of 11 days total (+- 5 -->
% analogous to Hobday) - increases the comparison values from 30 to
% 30 x 11 = 330 measurements per calendar day.
% 1.1 Calculate the climatological mean and the 90th and 10th percentiles
% 1.2 Threshold values for an extreme event are then below 10%,
% less-than-or-equal to 4 mg/L, and less-than-or-equal to 2 mg/L

%% 11. Day of Year Climatology Station-specific 

doy = day(DOraw.time, 'dayofyear'); 
windowRadius = 5;
nDoy = 366;

climP10 = NaN(nDoy,1);
climP90 = NaN(nDoy,1);

for d = 1:nDoy
    windowDoys = mod((d-windowRadius : d+windowRadius) -1, nDoy) +1;
    inWindow = ismember(doy, windowDoys);
    climP10(d) = prctile(DOraw.value(inWindow),10);
    climP90(d) = prctile(DOraw.value(inWindow),90);
end

assert(sum(isnan(climP10)) == 0, "Mindestens einer fehlt für P10");
assert(sum(isnan(climP90)) == 0, "Mindesten einer fehlt für P90");

figure ("Name","Climatology + 10 and 90 Percentile "+stationName);
fill([1:nDoy, fliplr(1:nDoy)],[climP10',fliplr(climP90')],[0.85 0.85 1], "EdgeColor","none","DisplayName","P10 - P90 Range");
hold on
plot(doyList, clim_doy_mean, "k-","LineWidth",1.5,"DisplayName","Climatology Mean");

monthStarts = datetime(2001,1:12,1); 
xticks(day(monthStarts, "dayofyear"));
xticklabels({'Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'});
xlim([1 366]);

xlabel("Month");
ylabel("DO [mg/L]");
title("Climatology P10 P90 "+stationName);
legend("Location","best");
grid off
exportgraphics(gcf, 'Climatology + 10 and 90 Percentile.png', 'Resolution', 300);

%% 11.1 Threshold values

p10_threshold = climP10(doy);
p90_threshold = climP90(doy);

is_below_p10 = DOraw.value < p10_threshold;
is_hypoxic = DOraw.value <= 4;
is_sevHypoxic = DOraw.value <= 2;
is_event    = is_below_p10 | is_hypoxic;

fprintf('Tage unter P10 :%d (%.1f%% aller Tage)\n',sum(is_below_p10), 100*sum(is_below_p10)/height(DOraw));
fprintf('Hypoxische Tage (<= 4 mg/L): %d (%.1f%% aller Tage)\n',sum(is_hypoxic), 100*sum(is_hypoxic)/height(DOraw));
fprintf('Anoxische Tage (<= 2 mg/L):  %d (%.1f%% aller Tage)\n', sum(is_sevHypoxic), 100*sum(is_sevHypoxic)/height(DOraw));

%% 12 Duration & Gap for Extreme Event Definition

% Approach: run an analysis with 1:1 (one day below threshold
% is an extreme, and it is separated from another extreme by one day above
% threshold).
% Then look at the median and mean length and gap

[~, ev_start_raw, ev_end_raw] = count_events_hobday(is_event, 1, 1);

ev_duration_raw = ev_end_raw - ev_start_raw + 1;

ev_gap_raw = ev_start_raw(2:end) - ev_end_raw(1:end-1) - 1;

fprintf('=== Rohevents (min_duration=1, max_gap=1) ===\n');
fprintf('Anzahl Rohevents: %d\n', length(ev_duration_raw));
fprintf('Dauer - Median: %.1f Tage, Mean: %.2f Tage\n', median(ev_duration_raw), mean(ev_duration_raw));
fprintf('Lücke - Median: %.1f Tage, Mean: %.2f Tage\n', median(ev_gap_raw), mean(ev_gap_raw));

figure('Name','Verteilung Dauer und Lücke der Rohevents - ' + stationName);
subplot(1,2,1)
histogram(ev_duration_raw, 'BinWidth', 1);
xlabel('Event Duration [Days]'); ylabel('Frequency'); grid off
title('Duration of Raw Events (1:1)');
subplot(1,2,2)
histogram(ev_gap_raw, 'BinWidth', 1);
xlabel('Gap between Events [Days]'); ylabel('Frequency'); grid off
title('Gaps between Raw Events (1:1)');
exportgraphics(gcf, 'Verteilung Dauer und Lücke der Rohevents.png', 'Resolution', 300);

for g = 1:5
    pct = 100 * sum(ev_gap_raw <= g) / length(ev_gap_raw);
    fprintf('Anteil Lücken <= %d Tage(n): %.1f%%\n', g, pct);
end

%% 13 Extreme Event Analysis

min_duration = 5;
max_gap = 2;

[n_events, ev_start, ev_end] = count_events_hobday(is_event,min_duration,max_gap);
is_hobday_event = false(size(is_event));
for i = 1:length(ev_start)
    is_hobday_event(ev_start(i):ev_end(i)) = true;
end
fprintf("Number of Found Events: %d\n",n_events);  

years = year(DOraw.time);
yearList = unique(years);
nYears = length(yearList);
ev_year = year(DOraw.time(ev_start)); 

n_events_per_year = NaN(nYears,1);       
n_days_below_per_year = NaN(nYears,1);    

for k = 1:nYears
    idx_yr = years == yearList(k);
    n_events_per_year(k) = sum(ev_year == yearList(k));
    n_days_below_per_year(k) = sum(is_hobday_event(idx_yr));
end

%% 13.a Categorize Event Days  (P10 / Hypoxic / Severe Hypoxic / Bridge)

category = zeros(height(DOraw), 1);               
category(is_hobday_event)                = 4;    
category(is_hobday_event & is_below_p10) = 1;      
category(is_hobday_event & is_hypoxic)   = 2;     
category(is_hobday_event & is_sevHypoxic)    = 3;     

fprintf('Überbrückte Eventtage ohne eigene Schwellenwert-Unterschreitung: %d\n', sum(category==4));

